{
    "Host": "${HOST}",
    "Port": ${PORT},
    "CodeOverseerConfigured": ${CODE_OVERSEER_CONFIGURED},
    "CodeOverseerEndpoint": "${CODE_OVERSEER_ENDPOINT}",
    "KeypointNotification": {
        "Enabled": ${KEYPOINT_NOTIFICATION_ENABLED},
        "Endpoint": "${KEYPOINT_NOTIFICATION_ENDPOINT}"
    },
    "Llm": {
        "Provider": "${LLM_PROVIDER}",
        "ApiKey": "${LLM_API_KEY}",
        "Url": "${LLM_URL}",
        "Model": "${LLM_MODEL}",
        "Temperature": ${LLM_TEMPERATURE},
        "TimeoutSeconds": ${LLM_TIMEOUT_SECONDS},
        "Headers": {
            ${LLM_HEADERS}
        }
    }
}